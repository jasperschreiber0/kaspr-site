# Dashboard (middleware.ts) — Basic Auth password gating /dashboard/*.
# If unset, /dashboard 404s for everyone (fails closed, not open).
DASHBOARD_PASSWORD=choose_a_strong_password

# Supabase — server-only, used by app/dashboard/page.tsx and
# app/dashboard/api/clients/route.ts. Never expose the service role key
# to the client; both files only ever run server-side.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe — used by app/api/checkout/route.ts. Price IDs must match what
# kaspr-agent1's src/stripeWebhook.js TIER_MAP expects.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_GROW=price_...
STRIPE_PRICE_FULL_STACK=price_...

# Base URLs of the other two Railway services — used only to build the
# Instagram/TikTok OAuth connect links shown after creating a client in
# /dashboard/new-client. Optional: leave unset and the links just won't
# be auto-generated (you'd construct them by hand instead).
AGENT1_BASE_URL=https://kaspr-agent1-production.up.railway.app
AGENT3_BASE_URL=https://kaspr-agent3-production.up.railway.app
